#!/usr/bin/env bash
# algo3-prune — weekly disk hygiene for Docker.
#
# Removes IMAGES unused for a week and old build cache. It deliberately never
# runs `docker container prune` or `docker system prune`: the stopped
# containers on this server are the retained rollback releases, and an image
# used by any container, stopped or not, is never removed by `image prune`.
set -euo pipefail

echo "before: $(df --output=pcent / | tail -1 | tr -d ' ') of / used"
docker image prune --all --force --filter "until=168h"
docker builder prune --all --force --filter "until=168h"
echo "after:  $(df --output=pcent / | tail -1 | tr -d ' ') of / used"
