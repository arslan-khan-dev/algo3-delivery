# /opt/algo3/ops/.env — root-owned, mode 0600, never committed.
# Netdata's alerts are emailed through healthchecks.io: the ping URL of the
# "server-alerts" check (period 365 days, grace 1 day). Netdata pings /fail
# while an alert is active and a plain ping once everything has cleared.
ALGO3_ALERTS_CHECK_URL=
