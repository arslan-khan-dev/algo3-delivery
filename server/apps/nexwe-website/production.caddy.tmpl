nexwe.app {
	encode zstd gzip
	# {{UPSTREAM}} is the stable alias nexwe-website-production, moved between
	# release containers by algo3-deploy. A connection that hits a release as it
	# stops gives up within 300 ms and is retried on the new one.
	reverse_proxy {{UPSTREAM}} {
		lb_try_duration 5s
		lb_try_interval 50ms
		transport http {
			dial_timeout 300ms
		}
	}
}

www.nexwe.app {
	redir https://nexwe.app{uri} permanent
}
