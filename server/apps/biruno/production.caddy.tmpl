# biruno, production. A custom template (the generated site cannot express
# these two): AI answers stream as Server-Sent Events, so every chunk is
# flushed at once (flush_interval -1), and uploads are capped at 25 MB here.
# Deliberately no `encode`: compressing a stream can hold chunks back.
{{HOSTNAME}} {
	request_body {
		max_size 25MB
	}
	reverse_proxy {{UPSTREAM}} {
		flush_interval -1
		lb_try_duration 5s
		lb_try_interval 50ms
		transport http {
			dial_timeout 300ms
		}
	}
}

www.birunoai.com {
	redir https://birunoai.com{uri} permanent
}
