# biruno, production. A custom template, because the generated site cannot express this:
#
#   {{HOSTNAME}} (app.birunoai.com)  the web app AND the API (one container).
#   api.birunoai.com  the API: /api/* only; anything else is sent to the app.
#   birunoai.com, www.birunoai.com now belong to biruno-landing (the marketing
#       site); its template still sends /api/* to this app (biruno-production:8100)
#       for installed desktop builds.
#
# Every block streams AI answers as Server-Sent Events (flush_interval -1, and
# deliberately no `encode`, which can hold chunks back) and caps uploads at 25 MB.
# The deployer requires the hosts here to be exactly HOSTNAME + ALIASES.
{{HOSTNAME}} {
	request_body {
		max_size 25MB
	}
	reverse_proxy {{UPSTREAM}} {
		flush_interval -1
		lb_try_duration 5s
		lb_try_interval 50ms
		transport http {
			dial_timeout 300ms
		}
	}
}

api.birunoai.com {
	handle /api/* {
		request_body {
			max_size 25MB
		}
		reverse_proxy {{UPSTREAM}} {
			flush_interval -1
			lb_try_duration 5s
			lb_try_interval 50ms
			transport http {
				dial_timeout 300ms
			}
		}
	}
	handle {
		redir https://app.birunoai.com{uri} 302
	}
}
