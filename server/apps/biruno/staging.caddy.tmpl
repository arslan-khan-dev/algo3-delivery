# biruno, staging. A custom template, because the generated site cannot express this:
#
#   {{HOSTNAME}} (staging-app.birunoai.com)  the web app AND the API (one container).
#   staging-api.birunoai.com  the API: /api/* only; anything else is sent to the app.
#   staging.birunoai.com
#       kept for the marketing site (not built yet). Until then: /api/* still
#       reaches the API, because installed desktop builds have this host baked
#       in; everything else goes to the app with a TEMPORARY 302, so browsers
#       do not remember it once the marketing site takes the domain.
#
# Every block streams AI answers as Server-Sent Events (flush_interval -1, and
# deliberately no `encode`, which can hold chunks back) and caps uploads at 25 MB.
# The deployer requires the hosts here to be exactly HOSTNAME + ALIASES.
# Staging: never indexed by search engines (a template sets this itself).
{{HOSTNAME}} {
	header X-Robots-Tag "noindex, nofollow, noarchive"
	request_body {
		max_size 25MB
	}
	reverse_proxy {{UPSTREAM}} {
		flush_interval -1
		lb_try_duration 5s
		lb_try_interval 50ms
		transport http {
			dial_timeout 300ms
		}
	}
}

staging-api.birunoai.com {
	header X-Robots-Tag "noindex, nofollow, noarchive"
	handle /api/* {
		request_body {
			max_size 25MB
		}
		reverse_proxy {{UPSTREAM}} {
			flush_interval -1
			lb_try_duration 5s
			lb_try_interval 50ms
			transport http {
				dial_timeout 300ms
			}
		}
	}
	handle {
		redir https://staging-app.birunoai.com{uri} 302
	}
}

staging.birunoai.com {
	header X-Robots-Tag "noindex, nofollow, noarchive"
	handle /api/* {
		request_body {
			max_size 25MB
		}
		reverse_proxy {{UPSTREAM}} {
			flush_interval -1
			lb_try_duration 5s
			lb_try_interval 50ms
			transport http {
				dial_timeout 300ms
			}
		}
	}
	handle {
		redir https://staging-app.birunoai.com{uri} 302
	}
}
