# biruno, staging. As production.caddy.tmpl, plus: never indexed by search
# engines (a template sets this itself; NOINDEX only applies to generated sites).
{{HOSTNAME}} {
	header X-Robots-Tag "noindex, nofollow, noarchive"
	request_body {
		max_size 25MB
	}
	reverse_proxy {{UPSTREAM}} {
		flush_interval -1
		lb_try_duration 5s
		lb_try_interval 50ms
		transport http {
			dial_timeout 300ms
		}
	}
}
