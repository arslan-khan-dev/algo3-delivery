#!/usr/bin/env bash
# algo3-cert-watch — keep Netdata's certificate checks in step with the
# registry: one x509check job for every public domain of every web app
# (HOSTNAME, ALIASES, REDIRECTS in /etc/algo3/apps/*/*.conf).
#
#   sudo algo3-cert-watch          (run by install.sh --app and baseline.sh ops)
#
# Netdata warns at 14 days to expiry and goes critical at 7. Caddy renews at
# about 30 days, so an alert means renewal is failing for that domain, whatever
# product it belongs to. Netdata is restarted only when the job list changed.
set -Eeuo pipefail

ETC="${ALGO3_ETC:-/etc/algo3}"
OUT="${ALGO3_X509_CONF:-/opt/algo3/ops/netdata/go.d/x509check.conf}"

if [[ ! -d "$(dirname "$OUT")" ]]; then
    echo "skipped    Netdata's config directory $(dirname "$OUT") is absent (baseline ops not installed)"
    exit 0
fi

domains() {
    local f
    for f in "$ETC"/apps/*/*.conf; do
        [[ -f "$f" ]] || continue
        # Only web apps have public domains (KIND defaults to web).
        grep -qE '^KIND="?(internal|worker)' "$f" && continue
        sed -nE 's/^(HOSTNAME|ALIASES|REDIRECTS)="?([^"]*)"?[[:space:]]*$/\2/p' "$f" | tr ',' '\n'
    done | { grep -E '^[a-z0-9.-]+$' || true; } | sort -u   # no apps yet is normal, not an error
}

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
{
    echo "# Generated by algo3-cert-watch from $ETC/apps. Do not edit: register"
    echo "# domains in the app's settings and run install.sh --app <name>."
    list="$(domains)"
    if [[ -z "$list" ]]; then
        echo "jobs: []"
    else
        echo "jobs:"
        while IFS= read -r d; do
            printf '  - name: %s\n    source: https://%s:443\n' "${d//[.-]/_}" "$d"
        done <<<"$list"
    fi
} > "$tmp"

if [[ -f "$OUT" ]] && cmp -s "$tmp" "$OUT"; then
    echo "unchanged  $OUT"
    exit 0
fi
install -o root -g root -m 0644 "$tmp" "$OUT"
echo "updated    $OUT ($(grep -c 'source:' "$OUT" || true) domain(s))"
if command -v docker >/dev/null && [[ "$(docker inspect -f '{{.State.Running}}' netdata 2>/dev/null)" == true ]]; then
    docker restart netdata >/dev/null && echo "restarted  netdata (to load the new certificate jobs)"
fi
