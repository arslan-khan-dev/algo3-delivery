#!/usr/bin/env bash
# algo3-deploy — blue/green deployer for every algo3 product on this VPS.
#
#   algo3-deploy deploy   <app> <env> <full-sha> [sha256:<digest>]
#   algo3-deploy rollback <app> <env>
#   algo3-deploy status   <app> <env>
#
# Runs as root, normally through algo3-deploy-wrapper (CI) or `sudo` (admin).
# Generalised from the proven /usr/local/libexec/deploy-nexwe.
#
# How a release goes live — WITHOUT reloading the edge:
#   Each release runs as its own container, <app>-<env>-<sha12>, never renamed.
#   The edge's site file points at a STABLE name, <app>-<env>, which is a
#   docker network alias. A new release starts without the alias, is checked
#   by name (health + release marker), then takes the alias; the old release
#   is stopped gracefully, which removes it from DNS. Caddy re-resolves the
#   name per connection, retries a failed dial (lb_try_duration, short
#   dial_timeout), and its configuration never changes.
#   Why: measured in the lab (2026-10-29), every Caddy reload drops roughly
#   one new connection in three — on EVERY site, not just the one deployed.
#   Moving the alias dropped none in 20 switches. The edge is reloaded only
#   when an app's domains or site template change (or on its first deploy).
#
# Every app/env is registered under /etc/algo3/apps/<app>/:
#   <env>.conf          KEY=value settings (see examples/), root-owned. A web
#                       app declares its domains here: HOSTNAME (primary),
#                       ALIASES (also served), REDIRECTS (sent to HOSTNAME),
#                       NOINDEX=true (keep search engines out, e.g. staging).
#                       The site is generated from these.
#   <env>.caddy.tmpl    OPTIONAL, for routing the generated site cannot express
#                       (e.g. /api to another app). {{UPSTREAM}} becomes
#                       <app>-<env>:<port>, {{HOSTNAME}} the primary domain. It
#                       must serve exactly the declared domains, and its
#                       reverse_proxy MUST set lb_try_duration and a short
#                       dial_timeout.
#   <env>.env           optional runtime secrets, root 0600, never sent by CI
#
# One domain belongs to exactly one app/env: a deploy that would claim a domain
# another registered app, or the platform, already serves is refused.
#
# Retention: exactly one previous release is kept, stopped, as the rollback.
# The release before that is removed only AFTER a new release is verified live.
set -Eeuo pipefail
umask 077

readonly ETC="${ALGO3_ETC:-/etc/algo3}"
readonly STATE="${ALGO3_STATE:-/var/lib/algo3}"
readonly LOG_FILE="${ALGO3_LOG:-/var/log/algo3/deploys.log}"
readonly LOCK_DIR="${ALGO3_LOCK_DIR:-/run/lock/algo3}"
readonly RETRY_SECONDS="${ALGO3_RETRY_SECONDS:-2}"

die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
log() { printf '[algo3-deploy] %s\n' "$*"; }

# ── Configuration ────────────────────────────────────────────────────────────
# A whitelist parser rather than `source`: a conf file is data, and sourcing it
# would execute anything that ends up in it.

declare -A CONF=()

read_conf() {
    local file="$1"; shift
    local allowed=" $* " line key value
    [[ -f "$file" ]] || die "Missing configuration: $file"
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
        [[ "$line" =~ ^([A-Z_]+)=(.*)$ ]] || die "Malformed line in $file: $line"
        key="${BASH_REMATCH[1]}"; value="${BASH_REMATCH[2]}"
        [[ "$allowed" == *" $key "* ]] || die "Unknown setting $key in $file"
        value="${value%\"}"; value="${value#\"}"
        CONF[$key]="$value"
    done < "$file"
}

conf() { printf '%s' "${CONF[$1]-${2-}}"; }

require_match() {
    local name="$1" value="$2" pattern="$3"
    [[ "$value" =~ $pattern ]] || die "Invalid $name: '$value'"
}

load_delivery_conf() {
    read_conf "$ETC/delivery.conf" EDGE_CONTAINER EDGE_NETWORK EDGE_MAIN_CONFIG SITES_DIR CHECK_DIR \
        PUBLIC_CHECK_IP PUBLIC_CHECK_PORT HEARTBEAT_URL SERVER_IPS
    EDGE="$(conf EDGE_CONTAINER studio-caddy)"
    EDGE_NET="$(conf EDGE_NETWORK studio)"
    require_match EDGE_NETWORK "$EDGE_NET" '^[a-z0-9_-]+$'
    EDGE_MAIN="$(conf EDGE_MAIN_CONFIG /etc/caddy/Caddyfile)"
    SITES_DIR="$(conf SITES_DIR /etc/algo3/caddy/sites)"
    CHECK_DIR="$(conf CHECK_DIR /etc/algo3/caddy/check)"
    PUBLIC_IP="$(conf PUBLIC_CHECK_IP 127.0.0.1)"
    PUBLIC_PORT="$(conf PUBLIC_CHECK_PORT 443)"
    HEARTBEAT="$(conf HEARTBEAT_URL)"
    # This server's public addresses. When set, every deploy checks that each
    # domain's DNS points here and warns otherwise (a warning, not a refusal:
    # behind a CDN such as Cloudflare, DNS legitimately points elsewhere).
    SERVER_IPS="$(conf SERVER_IPS)"
    require_match SERVER_IPS "$SERVER_IPS" '^([0-9a-fA-F.:]+(,[0-9a-fA-F.:]+)*)?$'
    require_match EDGE_CONTAINER "$EDGE" '^[a-z0-9][a-z0-9_.-]*$'
    require_match PUBLIC_CHECK_IP "$PUBLIC_IP" '^[0-9.]+$'
    require_match PUBLIC_CHECK_PORT "$PUBLIC_PORT" '^[0-9]{2,5}$'
}

load_app_conf() {
    local dir="$ETC/apps/$APP"
    CONF=()
    read_conf "$dir/$ENV_NAME.conf" KIND IMAGE CONTAINER_PORT HEALTH_PATH RELEASE_PATH RELEASE_KEY \
        HOSTNAME ALIASES REDIRECTS NOINDEX PUBLIC_PATH NETWORKS MEM_LIMIT CPUS READ_ONLY TMPFS \
        PROMOTE_FROM HEALTH_ATTEMPTS RELEASE_COMMAND RELEASE_TIMEOUT VOLUMES OVERLAP STARTUP_SECONDS
    # KIND decides how a release goes live:
    #   web       HTTP, public hostname: stable alias + edge site + public check
    #   internal  HTTP for other containers only: stable alias, no site
    #   worker    no HTTP (queue consumer, scheduler): health from Docker, no alias
    KIND="$(conf KIND web)"
    require_match KIND "$KIND" '^(web|internal|worker)$'
    IMAGE="$(conf IMAGE)"
    PORT="$(conf CONTAINER_PORT 80)"
    if [[ "$KIND" == worker ]]; then
        HEALTH_PATH=""; RELEASE_PATH=""
    else
        HEALTH_PATH="$(conf HEALTH_PATH /)"
        # Optional: when empty, release identity rests on the image digest alone.
        RELEASE_PATH="$(conf RELEASE_PATH "$( [[ "$KIND" == web ]] && echo /release.json )")"
    fi
    RELEASE_KEY="$(conf RELEASE_KEY release)"
    RELEASE_COMMAND="$(conf RELEASE_COMMAND)"
    RELEASE_TIMEOUT="$(conf RELEASE_TIMEOUT 300)"
    VOLUMES="$(conf VOLUMES)"
    OVERLAP="$(conf OVERLAP true)"
    STARTUP_SECONDS="$(conf STARTUP_SECONDS 10)"
    HOSTNAME_PUBLIC="$(conf HOSTNAME)"
    ALIASES="$(conf ALIASES)"
    REDIRECTS="$(conf REDIRECTS)"
    NOINDEX="$(conf NOINDEX false)"
    PUBLIC_PATH="$(conf PUBLIC_PATH /)"
    NETWORKS="$(conf NETWORKS studio)"
    MEM_LIMIT="$(conf MEM_LIMIT 256m)"
    CPUS="$(conf CPUS 0.5)"
    READ_ONLY="$(conf READ_ONLY false)"
    TMPFS="$(conf TMPFS)"
    PROMOTE_FROM="$(conf PROMOTE_FROM)"
    ATTEMPTS="$(conf HEALTH_ATTEMPTS 30)"

    require_match IMAGE "$IMAGE" '^[a-z0-9][a-z0-9.-]*(:[0-9]{1,5})?(/[a-z0-9._-]+)+$'
    require_match CONTAINER_PORT "$PORT" '^[0-9]{2,5}$'
    require_match HEALTH_PATH "$HEALTH_PATH" '^(/[A-Za-z0-9._/-]*)?$'
    require_match RELEASE_PATH "$RELEASE_PATH" '^(/[A-Za-z0-9._/-]*)?$'
    require_match RELEASE_KEY "$RELEASE_KEY" '^[A-Za-z0-9_]+$'
    load_domains
    require_match RELEASE_TIMEOUT "$RELEASE_TIMEOUT" '^[0-9]{1,5}$'
    require_match OVERLAP "$OVERLAP" '^(true|false)$'
    require_match STARTUP_SECONDS "$STARTUP_SECONDS" '^[0-9]{1,4}$'
    [[ "$RELEASE_COMMAND" != *$'\n'* ]] || die "RELEASE_COMMAND must be one line"
    if [[ -n "$VOLUMES" ]]; then
        # Named volumes only, and only the app's own: never a host path, never
        # another app's data.
        require_match VOLUMES "$VOLUMES" "^$APP-[a-z0-9_.-]+:/[A-Za-z0-9._/-]+(:ro)?(,$APP-[a-z0-9_.-]+:/[A-Za-z0-9._/-]+(:ro)?)*\$"
    fi
    require_match PUBLIC_PATH "$PUBLIC_PATH" '^/[A-Za-z0-9._/-]*$'
    require_match NETWORKS "$NETWORKS" '^[a-z0-9_-]+(,[a-z0-9_-]+)*$'
    require_match MEM_LIMIT "$MEM_LIMIT" '^[0-9]+[mg]$'
    require_match CPUS "$CPUS" '^[0-9]+(\.[0-9]+)?$'
    require_match READ_ONLY "$READ_ONLY" '^(true|false)$'
    [[ -z "$TMPFS" ]] || require_match TMPFS "$TMPFS" '^/[A-Za-z0-9._/-]+(,/[A-Za-z0-9._/-]+)*$'
    [[ -z "$PROMOTE_FROM" ]] || require_match PROMOTE_FROM "$PROMOTE_FROM" '^[a-z][a-z0-9-]{0,20}$'
    require_match HEALTH_ATTEMPTS "$ATTEMPTS" '^[0-9]{1,3}$'

    TEMPLATE="$dir/$ENV_NAME.caddy.tmpl"
    ENV_FILE="$dir/$ENV_NAME.env"
    SITE_FILE="$SITES_DIR/$APP-$ENV_NAME.caddy"
    BASE="$APP-$ENV_NAME"
    NET="${NETWORKS%%,*}"
    [[ "$KIND" == web ]] || return 0   # only a public web app has an edge site
    [[ -f "$TEMPLATE" ]] || return 0   # the usual case: the site is generated from the domains
    [[ "$(grep -c '{{UPSTREAM}}' "$TEMPLATE")" -ge 1 ]] || die "Template has no {{UPSTREAM}}: $TEMPLATE"
    # Without these, a request that resolves the alias to a release that is
    # just stopping hangs until a long default timeout instead of retrying the
    # new release within milliseconds.
    if ! grep -q 'lb_try_duration' "$TEMPLATE" || ! grep -q 'dial_timeout' "$TEMPLATE"; then
        die "Template's reverse_proxy must set lb_try_duration and dial_timeout: $TEMPLATE"
    fi
    # The declared domains are what ownership and the checks use, so a template
    # must serve exactly those: no more (an undeclared domain escapes the
    # ownership check), no fewer (a declared one would never be served).
    local served wanted
    served="$(sed "s/{{HOSTNAME}}/$HOSTNAME_PUBLIC/g" "$TEMPLATE" | site_addresses - | sort -u)"
    wanted="$(printf '%s\n' "${DOMAINS[@]}" | sort -u)"
    [[ "$served" == "$wanted" ]] ||
        die "Template $TEMPLATE serves [$(paste -sd' ' <<<"$served")] but the settings declare [$(paste -sd' ' <<<"$wanted")]; make HOSTNAME/ALIASES/REDIRECTS match it"
}

# ── Domains ──────────────────────────────────────────────────────────────────
# A web app has one primary domain (HOSTNAME), optional ALIASES served the same
# way, and optional REDIRECTS sent permanently to the primary (www.example.com).
# Different products naturally have different domains; within the server, each
# domain belongs to exactly one app/env.

readonly DOMAIN_RE='[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+'
DOMAINS=()

load_domains() {
    DOMAINS=()
    if [[ "$KIND" != web ]]; then
        [[ -z "$HOSTNAME_PUBLIC$ALIASES$REDIRECTS" ]] ||
            die "Only KIND=web has public domains; remove HOSTNAME/ALIASES/REDIRECTS from this $KIND app"
        return 0
    fi
    require_match HOSTNAME "$HOSTNAME_PUBLIC" "^$DOMAIN_RE\$"
    require_match ALIASES "$ALIASES" "^($DOMAIN_RE(,$DOMAIN_RE)*)?\$"
    require_match REDIRECTS "$REDIRECTS" "^($DOMAIN_RE(,$DOMAIN_RE)*)?\$"
    require_match NOINDEX "$NOINDEX" '^(true|false)$'
    local d
    DOMAINS=("$HOSTNAME_PUBLIC")
    for d in ${ALIASES//,/ } ${REDIRECTS//,/ }; do DOMAINS+=("$d"); done
    d="$(printf '%s\n' "${DOMAINS[@]}" | sort | uniq -d | paste -sd' ')"
    [[ -z "$d" ]] || die "Domain declared more than once: $d"
}

site_addresses() {   # site_addresses <file|->: the host names a Caddyfile's top-level blocks serve
    python3 -c '
import re, sys
text = sys.stdin.read() if sys.argv[1] == "-" else open(sys.argv[1]).read()
depth = 0
for raw in text.splitlines():
    line = raw.strip()
    if not line or line.startswith("#"):
        continue
    if depth == 0 and line.endswith("{") and not line.startswith("("):
        for a in re.split(r"[\s,]+", line[:-1].strip()):
            if a:
                a = re.sub(r"^[a-z]+://", "", a).split("/", 1)[0]
                print(re.sub(r":[0-9]+$", "", a).lower())
    depth += line.count("{") - line.count("}")
' "$1"
}

declared_domains() {   # declared_domains <conf file>: its HOSTNAME, ALIASES, REDIRECTS, one per line
    sed -nE 's/^(HOSTNAME|ALIASES|REDIRECTS)="?([^"]*)"?[[:space:]]*$/\2/p' "$1" | tr ',' '\n' | sed '/^$/d'
}

# Refuse a domain that another registered app/env, or the platform's own sites
# (/etc/algo3/caddy/platform), already claims. Caddy would also refuse the
# duplicate, but only at reload time and as an "ambiguous site definition".
# Checked on deploy only: another app's mistake must never block a rollback.
check_domain_ownership() {
    [[ "$KIND" == web ]] || return 0
    local f owner d mine platform
    for f in "$ETC"/apps/*/*.conf; do
        [[ -f "$f" ]] || continue
        owner="$(basename "$(dirname "$f")")/$(basename "$f" .conf)"
        [[ "$owner" == "$APP/$ENV_NAME" ]] && continue
        while IFS= read -r d; do
            for mine in "${DOMAINS[@]}"; do
                [[ "$d" == "$mine" ]] &&
                    die "$mine is already claimed by $owner ($f); a domain belongs to exactly one app and environment"
            done
        done < <(declared_domains "$f")
    done
    platform="$(dirname "$SITES_DIR")/platform"
    for f in "$platform"/*.caddy; do
        [[ -f "$f" ]] || continue
        while IFS= read -r d; do
            for mine in "${DOMAINS[@]}"; do
                [[ "$d" == "$mine" ]] && die "$mine is already served by the platform ($f)"
            done
        done < <(site_addresses "$f")
    done
    # Without this the function returns the status of its LAST command: the
    # final `[[ … ]] && die` above is false when nothing clashes, so a clean
    # check returned failure and `set -e` stopped the deploy silently. Hidden
    # until the platform had sites to loop over (lab, 2026-10-30).
    return 0
}

DNS_PROBLEMS=()
check_dns() {   # warn about domains whose DNS does not point at this server
    DNS_PROBLEMS=()
    [[ "$KIND" == web && -n "$SERVER_IPS" ]] || return 0
    command -v getent >/dev/null || { log "WARNING: getent unavailable; DNS not checked"; return 0; }
    local d ips ip p stray
    for d in "${DOMAINS[@]}"; do
        ips="$(getent ahosts "$d" 2>/dev/null | awk '{print $1}' | sort -u | paste -sd, - || true)"
        if [[ -z "$ips" ]]; then
            DNS_PROBLEMS+=("$d does not resolve")
            continue
        fi
        # Every address must be ours: Let's Encrypt may validate over any of
        # them (it prefers IPv6), and visitors land on all of them.
        stray=""
        for ip in ${ips//,/ }; do
            [[ ",$SERVER_IPS," == *",$ip,"* ]] || stray+="${stray:+,}$ip"
        done
        [[ -z "$stray" ]] || DNS_PROBLEMS+=("$d resolves to $stray, which is not this server ($SERVER_IPS)")
    done
    for p in "${DNS_PROBLEMS[@]}"; do
        log "WARNING: DNS: $p. Its certificate cannot be issued until its A/AAAA records point here."
    done
}

dns_hint() {   # appended to a failed public check: the likely reason
    [[ ${#DNS_PROBLEMS[@]} -gt 0 ]] || return 0
    printf '. DNS: %s' "$(printf '%s; ' "${DNS_PROBLEMS[@]}")"
}

# The primary domain is THE check (public_serves). Aliases and redirects are
# checked too, but only warn: they serve the same release, so a failure there is
# DNS or a certificate still being issued, which rolling back cannot fix.
DOMAIN_WARNINGS=0
check_other_domains() {
    DOMAIN_WARNINGS=0
    local d i out attempts=$(( ATTEMPTS < 10 ? ATTEMPTS : 10 )) good
    for d in ${ALIASES//,/ }; do
        good=false
        for ((i = 1; i <= attempts; i++)); do
            if curl --fail --silent --max-time 5 --resolve "$d:$PUBLIC_PORT:$PUBLIC_IP" \
                    "https://$d:$PUBLIC_PORT$PUBLIC_PATH" >/dev/null 2>&1; then
                good=true; break
            fi
            sleep "$RETRY_SECONDS"
        done
        if [[ "$good" == true ]]; then
            log "https://$d (alias) answers"
        else
            DOMAIN_WARNINGS=$((DOMAIN_WARNINGS + 1))
            log "WARNING: https://$d (alias) does not answer: check its DNS and certificate"
        fi
    done
    for d in ${REDIRECTS//,/ }; do
        good=false
        for ((i = 1; i <= attempts; i++)); do
            out="$(curl --silent --max-time 5 --resolve "$d:$PUBLIC_PORT:$PUBLIC_IP" -o /dev/null \
                --write-out '%{http_code} %{redirect_url}' "https://$d:$PUBLIC_PORT/" 2>/dev/null || true)"
            if [[ "$out" == "301 https://$HOSTNAME_PUBLIC/" || "$out" == "308 https://$HOSTNAME_PUBLIC/" ]]; then
                good=true; break
            fi
            sleep "$RETRY_SECONDS"
        done
        if [[ "$good" == true ]]; then
            log "https://$d redirects to https://$HOSTNAME_PUBLIC/"
        else
            DOMAIN_WARNINGS=$((DOMAIN_WARNINGS + 1))
            log "WARNING: https://$d does not redirect to https://$HOSTNAME_PUBLIC/ (got '${out:-no answer}'): check its DNS and certificate"
        fi
    done
}

# ── Docker helpers ───────────────────────────────────────────────────────────

c_exists()  { docker inspect --format '{{.Id}}' "$1" >/dev/null 2>&1; }
c_status()  { docker inspect --format '{{.State.Status}}' "$1" 2>/dev/null || true; }
c_health()  { docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$1" 2>/dev/null || true; }
c_label()   { docker inspect --format "{{index .Config.Labels \"$2\"}}" "$1" 2>/dev/null || true; }
c_created() { docker inspect --format '{{.Created}}' "$1" 2>/dev/null || true; }

# Containers of this app/env, newest first.
app_containers() {
    local name
    docker ps -a --filter "label=algo3.app=$APP" --filter "label=algo3.env=$ENV_NAME" \
        --format '{{.Names}}' | while IFS= read -r name; do
        [[ -n "$name" ]] && printf '%s %s\n' "$(c_created "$name")" "$name"
    done | sort -r | awk '{print $2}'
}

# Give or take the stable alias <app>-<env> on the edge network. Docker can
# only change an alias by reconnecting, so this is a disconnect + connect —
# done only while the container is NOT serving under that alias.
set_alias() {   # set_alias <container> on|off
    docker network disconnect --force "$NET" "$1" >/dev/null 2>&1 || true
    if [[ "$2" == on ]]; then
        docker network connect --alias "$BASE" "$NET" "$1"
    else
        docker network connect "$NET" "$1"
    fi
}

edge_fetch() {   # edge_fetch <container> <path> → body on stdout
    if [[ "$NET" == "$EDGE_NET" ]]; then
        docker exec "$EDGE" wget -q -O - -T 5 "http://$1:$PORT$2" 2>/dev/null
    else
        # The app lives on another network (e.g. its own, beside its database):
        # check it from a throwaway container on THAT network, using the edge's
        # image (already on the machine, and it has wget).
        [[ -n "${CHECKER_IMAGE:-}" ]] || CHECKER_IMAGE="$(docker inspect --format '{{.Config.Image}}' "$EDGE")"
        docker run --rm --network "$NET" --entrypoint wget "$CHECKER_IMAGE" \
            -q -O - -T 5 "http://$1:$PORT$2" 2>/dev/null
    fi
}

# The running container is exactly the image that was asked for: the same
# image ID as IMAGE@digest. Works for any app, with or without a release marker.
image_matches() {   # image_matches <container> <digest>
    local want have
    want="$(docker image inspect --format '{{.Id}}' "$IMAGE@$2" 2>/dev/null)" || return 1
    have="$(docker inspect --format '{{.Image}}' "$1" 2>/dev/null)" || return 1
    [[ -n "$want" && "$want" == "$have" ]]
}

# RELEASE_COMMAND (migrations, cache warm-up…) runs ONCE from the new image,
# before it takes any traffic, with the app's secrets, networks and volumes.
# Parsed without a shell: the first word becomes the entrypoint, so it works
# whatever the image's own ENTRYPOINT is; use `sh -c '…'` for shell features.
#
# It is parsed at the start of a deploy, so a typo such as an unclosed quote is
# refused before anything is pulled, with the parser's own reason. Python's
# exit status is checked directly: `while read … done < <(python …)` hides it.
RELEASE_ARGV=()
parse_release_command() {
    RELEASE_ARGV=()
    [[ -n "$RELEASE_COMMAND" ]] || return 0
    local words reason
    words="$(mktemp)"
    if ! reason="$(python3 -c '
import shlex, sys
try:
    words = shlex.split(sys.argv[1])
except ValueError as e:
    sys.stderr.write(str(e)); sys.exit(2)
sys.stdout.buffer.write(b"".join(w.encode() + b"\0" for w in words))
' "$RELEASE_COMMAND" 2>&1 >"$words")"; then
        rm -f "$words"
        die "RELEASE_COMMAND cannot be parsed (${reason:-unknown error}): $RELEASE_COMMAND"
    fi
    mapfile -d '' -t RELEASE_ARGV <"$words"
    rm -f "$words"
    [[ ${#RELEASE_ARGV[@]} -gt 0 ]] || die "RELEASE_COMMAND has no command word: $RELEASE_COMMAND"
}

run_release_command() {   # run_release_command <sha> <digest>
    [[ ${#RELEASE_ARGV[@]} -gt 0 ]] || return 0
    local name="$BASE-release-${1:0:12}" rc=0
    local -a argv=("${RELEASE_ARGV[@]}")
    local -a args=(run --name "$name" --memory "$MEM_LIMIT" --cpus "$CPUS"
        --label "algo3.release-command=$APP/$ENV_NAME"
        --network "$NET" --entrypoint "${argv[0]}")
    [[ -f "$ENV_FILE" ]] && args+=(--env-file "$ENV_FILE")
    volume_args args
    args+=("$IMAGE@$2" "${argv[@]:1}")
    docker rm -f "$name" >/dev/null 2>&1 || true
    log "Running the release command: $RELEASE_COMMAND"
    timeout "$RELEASE_TIMEOUT" docker "${args[@]}" 2>&1 | sed 's/^/    /' || rc=$?
    if [[ $rc -ne 0 ]]; then
        docker rm -f "$name" >/dev/null 2>&1 || true
        die "Release command failed (exit $rc); nothing was switched, the live release is untouched"
    fi
    rc="$(docker inspect --format '{{.State.ExitCode}}' "$name" 2>/dev/null || echo 1)"
    docker rm -f "$name" >/dev/null 2>&1 || true
    [[ "$rc" == 0 ]] || die "Release command exited $rc; nothing was switched, the live release is untouched"
}

volume_args() {   # volume_args <array-name>: append --volume for each VOLUMES entry
    local -n out="$1"
    local entry
    [[ -n "$VOLUMES" ]] || return 0
    IFS=',' read -r -a vols <<<"$VOLUMES"
    for entry in "${vols[@]}"; do out+=(--volume "$entry"); done
}

json_key_equals() {   # stdin JSON; exit 0 when .<key> == <expected>
    python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(1)
sys.exit(0 if isinstance(data, dict) and data.get(sys.argv[1]) == sys.argv[2] else 1)
' "$1" "$2"
}

# ── State: which release is live ─────────────────────────────────────────────

live_file() { printf '%s/%s/%s.live' "$STATE" "$APP" "$ENV_NAME"; }

live_container() {   # the live release's container, if it still exists
    local file name
    file="$(live_file)"
    [[ -f "$file" ]] || return 0
    name="$(head -1 "$file")"
    [[ "$name" =~ ^[a-z0-9][a-z0-9_.-]*$ ]] || return 0
    c_exists "$name" && printf '%s' "$name"
    return 0
}

set_live() {   # set_live <container>
    mkdir -p "$STATE/$APP"
    printf '%s\n' "$1" > "$(live_file).new"
    mv -f "$(live_file).new" "$(live_file)"
}

# ── Edge (Caddy container) ───────────────────────────────────────────────────
# The site file points at the stable alias, so it only changes when the
# template does. Most deploys never touch it, and never reload the edge.

render_site() {   # render_site <dest>
    {
        printf '# algo3: app=%s env=%s upstream=%s\n' "$APP" "$ENV_NAME" "$BASE"
        if [[ -f "$TEMPLATE" ]]; then
            printf '# Written by algo3-deploy from %s. Edit the template, not this file.\n' "$TEMPLATE"
            sed -e "s/{{UPSTREAM}}/$BASE:$PORT/g" -e "s/{{HOSTNAME}}/$HOSTNAME_PUBLIC/g" "$TEMPLATE"
        else
            render_generated_site
        fi
    } > "$1"
}

# The standard site, from the domain settings. The retry settings are the ones
# zero-downtime switching depends on (see the header): a connection that hits a
# release as it stops gives up within 300 ms and is retried on the new one.
render_generated_site() {
    local served="$HOSTNAME_PUBLIC" d
    printf '# Generated by algo3-deploy from %s (HOSTNAME, ALIASES, REDIRECTS, NOINDEX).\n' \
        "$ETC/apps/$APP/$ENV_NAME.conf"
    [[ -n "$ALIASES" ]] && served+=", ${ALIASES//,/, }"
    printf '%s {\n\tencode zstd gzip\n' "$served"
    [[ "$NOINDEX" == true ]] && printf '\theader X-Robots-Tag "noindex, nofollow, noarchive"\n'
    printf '\treverse_proxy %s {\n\t\tlb_try_duration 5s\n\t\tlb_try_interval 50ms\n' "$BASE:$PORT"
    printf '\t\ttransport http {\n\t\t\tdial_timeout 300ms\n\t\t}\n\t}\n}\n'
    for d in ${REDIRECTS//,/ }; do
        printf '\n%s {\n\tredir https://%s{uri} permanent\n}\n' "$d" "$HOSTNAME_PUBLIC"
    done
}

validate_with() {   # validate_with <candidate site file>
    local check main
    check="$(mktemp -d "$CHECK_DIR/check.XXXXXX")"
    chmod 0755 "$check"
    cp -p "$SITES_DIR"/*.caddy "$check/" 2>/dev/null || true
    cp "$1" "$check/$(basename "$SITE_FILE")"
    chmod 0644 "$check"/*.caddy
    main="$(docker exec "$EDGE" cat "$EDGE_MAIN")" || { rm -rf "$check"; return 1; }
    if [[ "$(grep -c "import $SITES_DIR/\*.caddy" <<<"$main")" -ne 1 ]]; then
        rm -rf "$check"
        die "Edge Caddyfile must contain exactly one 'import $SITES_DIR/*.caddy'"
    fi
    # shellcheck disable=SC2001 # a literal path containing "*", clearer with sed
    sed "s#import $SITES_DIR/\*\.caddy#import $check/*.caddy#" <<<"$main" > "$check/Caddyfile"
    chmod 0644 "$check/Caddyfile"
    local rc=0
    docker exec "$EDGE" caddy validate --config "$check/Caddyfile" --adapter caddyfile >/dev/null || rc=$?
    rm -rf "$check"
    return "$rc"
}

reload_edge() {
    docker exec "$EDGE" caddy reload --config "$EDGE_MAIN" --adapter caddyfile
}

ensure_site() {   # write + validate + reload, only if the rendered site changed
    local candidate
    candidate="$(mktemp "$CHECK_DIR/site.XXXXXX")"
    render_site "$candidate"
    if [[ -f "$SITE_FILE" ]] && cmp -s "$candidate" "$SITE_FILE"; then
        rm -f "$candidate"
        return 0
    fi
    if ! validate_with "$candidate"; then
        rm -f "$candidate"
        die "Edge rejected the site configuration for $APP/$ENV_NAME ($( [[ -f "$TEMPLATE" ]] && echo "from $TEMPLATE" || echo generated ))"
    fi
    # One edge, many apps: serialise configuration changes across all of them.
    exec 8>"$LOCK_DIR/edge.lock"
    flock -w 120 8 || die "Timed out waiting for the edge lock"
    if [[ -f "$SITE_FILE" ]]; then
        SITE_BACKUP="$(mktemp "$CHECK_DIR/backup.XXXXXX")"
        cp -p "$SITE_FILE" "$SITE_BACKUP"
    fi
    SITE_CHANGED=true
    install -m 0644 "$candidate" "$SITE_FILE.new"
    mv -f "$SITE_FILE.new" "$SITE_FILE"
    rm -f "$candidate"
    log "Site configuration changed; reloading the edge"
    reload_edge >/dev/null || die "Edge reload failed"
    flock -u 8
}

# ── Checks ───────────────────────────────────────────────────────────────────

wait_ready() {   # wait_ready <container>
    # Ready means, in order of what the app offers:
    #   an HTTP health path          → it answers (and Docker health is not failing)
    #   a Docker HEALTHCHECK         → Docker reports healthy
    #   neither (e.g. a plain worker) → it stays running for STARTUP_SECONDS
    local name="$1" i status health up_since="" restarts=""
    for ((i = 1; i <= ATTEMPTS; i++)); do
        status="$(c_status "$name")"
        if [[ "$status" == "exited" || "$status" == "dead" || -z "$status" ]]; then
            log "Container $name is $status; last log lines:"
            docker logs --tail 30 "$name" 2>&1 | sed 's/^/    /' || true
            return 1
        fi
        health="$(c_health "$name")"
        if [[ "$health" == "unhealthy" ]]; then
            log "Container $name reports unhealthy"
            return 1
        fi
        if [[ -n "$HEALTH_PATH" ]]; then
            if [[ "$health" != "starting" ]] && edge_fetch "$name" "$HEALTH_PATH" >/dev/null; then
                return 0
            fi
        elif [[ "$health" != "none" ]]; then
            [[ "$health" == "healthy" ]] && return 0
        else
            # No health signal at all: running continuously, without restarting,
            # for STARTUP_SECONDS.
            local now count
            now="$(date +%s)"
            count="$(docker inspect --format '{{.RestartCount}}' "$name" 2>/dev/null || echo 0)"
            if [[ "$status" == running && -n "$up_since" && "$count" == "$restarts" ]]; then
                (( now - up_since >= STARTUP_SECONDS )) && return 0
            else
                up_since="$now"; restarts="$count"
            fi
        fi
        sleep "$RETRY_SECONDS"
    done
    log "Container $name did not become ready"
    return 1
}

marker_matches() {   # marker_matches <container> <sha>
    edge_fetch "$1" "$RELEASE_PATH" | json_key_equals "$RELEASE_KEY" "$2"
}

public_serves() {   # public_serves <sha>: through the real edge, TLS included
    local sha="$1" i
    for ((i = 1; i <= ATTEMPTS; i++)); do
        if curl --fail --silent --max-time 5 --resolve "$HOSTNAME_PUBLIC:$PUBLIC_PORT:$PUBLIC_IP" \
                "https://$HOSTNAME_PUBLIC:$PUBLIC_PORT$PUBLIC_PATH" >/dev/null 2>&1; then
            # Without a release marker, answering is the check (the old release
            # is stopped by now, so only the new one can answer).
            [[ -z "$RELEASE_PATH" ]] && return 0
            if curl --fail --silent --max-time 5 --resolve "$HOSTNAME_PUBLIC:$PUBLIC_PORT:$PUBLIC_IP" \
                    --header 'Cache-Control: no-cache' \
                    "https://$HOSTNAME_PUBLIC:$PUBLIC_PORT$RELEASE_PATH" 2>/dev/null |
                    json_key_equals "$RELEASE_KEY" "$sha"; then
                return 0
            fi
        fi
        sleep "$RETRY_SECONDS"
    done
    return 1
}

# ── Records ──────────────────────────────────────────────────────────────────

record() {   # record <action> <result> <sha> <digest> <detail>
    mkdir -p "$(dirname "$LOG_FILE")"
    printf '%s action=%s app=%s env=%s result=%s release=%s digest=%s detail=%s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$APP" "$ENV_NAME" "$2" "$3" "${4:--}" "${5:--}" \
        >> "$LOG_FILE"
}

history_add() {   # history_add <sha> <digest>: releases verified live on this env
    mkdir -p "$STATE/$APP"
    printf '%s %s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$2" >> "$STATE/$APP/$ENV_NAME.history"
}

was_live_on() {   # was_live_on <env> <sha> <digest>
    local file="$STATE/$APP/$1.history"
    [[ -f "$file" ]] && awk -v s="$2" -v d="$3" '$2 == s && $3 == d { found = 1 } END { exit !found }' "$file"
}

heartbeat() {   # heartbeat ok|fail
    [[ -n "$HEARTBEAT" ]] || return 0
    local url="$HEARTBEAT"
    [[ "$1" == "fail" ]] && url="$HEARTBEAT/fail"
    curl --fail --silent --max-time 10 --retry 2 "$url" >/dev/null 2>&1 || true
}

# ── The switch, shared by deploy and rollback ────────────────────────────────
# State the EXIT trap reads. Each flag is set BEFORE the action it describes,
# so an interruption between "docker did it" and "we noted it" errs on the
# side of attempting recovery.

TARGET=""; TARGET_SHA=""; TARGET_DIGEST=""; TARGET_WAS_NEW=false
PREVIOUS=""; SITE_BACKUP=""; SITE_CHANGED=false
PREVIOUS_STOPPED=false # the previous release has been stopped by this run
ACTION=""; DONE=false

recover() {
    local rc=$?
    trap - EXIT
    if [[ "$DONE" == true || "$rc" -eq 0 ]]; then
        [[ -n "$SITE_BACKUP" ]] && rm -f "$SITE_BACKUP"
        exit "$rc"
    fi
    log "$ACTION failed; recovering"
    local restored=true

    if [[ "$PREVIOUS_STOPPED" == true ]]; then
        # The old release had stopped serving: it must be back BEFORE the
        # target is taken away, or nothing answers at all.
        restored=false
        if [[ -n "$PREVIOUS" ]] && c_exists "$PREVIOUS"; then
            docker start "$PREVIOUS" >/dev/null 2>&1 || log "CRITICAL: could not start $PREVIOUS"
            if wait_ready "$PREVIOUS"; then
                restored=true
                log "Previous release $PREVIOUS serving again"
            else
                log "CRITICAL: previous release $PREVIOUS is not healthy; leaving $TARGET serving"
            fi
        else
            log "CRITICAL: previous release ${PREVIOUS:-?} no longer exists; leaving $TARGET serving"
        fi
    fi

    if [[ "$SITE_CHANGED" == true && "$restored" == true ]]; then
        if [[ -n "$SITE_BACKUP" ]]; then
            cp -p "$SITE_BACKUP" "$SITE_FILE.restore" && mv -f "$SITE_FILE.restore" "$SITE_FILE"
        else
            # First deploy of this app/env: there was no site before.
            rm -f "$SITE_FILE"
        fi
        reload_edge >/dev/null 2>&1 || { restored=false; log "CRITICAL: edge reload failed while restoring $SITE_FILE"; }
        [[ "$restored" == true ]] && log "Site configuration restored"
    fi

    # The target is taken out only when traffic is confirmed elsewhere. A
    # reused rollback container is stopped, never removed: it is still the
    # retained release (it keeps its alias, as a stopped container answers
    # nothing).
    if [[ -n "$TARGET" ]] && c_exists "$TARGET" && [[ "$TARGET" != "$PREVIOUS" ]]; then
        if [[ "$restored" == true ]]; then
            if [[ "$TARGET_WAS_NEW" == true ]]; then
                docker rm -f "$TARGET" >/dev/null 2>&1 || log "WARNING: could not remove $TARGET"
            else
                docker stop "$TARGET" >/dev/null 2>&1 || true
            fi
        else
            log "Keeping $TARGET serving because recovery is not confirmed"
        fi
    fi

    [[ -n "$SITE_BACKUP" && "$restored" == true ]] && rm -f "$SITE_BACKUP"
    [[ -n "$SITE_BACKUP" && "$restored" != true ]] && log "Site backup kept at $SITE_BACKUP"
    record "$ACTION" "failed" "${TARGET_SHA:--}" "$TARGET_DIGEST" "$( [[ $restored == true ]] && echo recovered || echo MANUAL-RECOVERY-NEEDED )"
    heartbeat fail
    exit "$rc"
}

make_live() {   # make_live <container> <sha> <digest>: target is running WITHOUT the alias
    local target="$1" sha="$2" digest="$3"
    wait_ready "$target" || die "$target failed its readiness check"
    image_matches "$target" "$digest" || die "$target is not running image $IMAGE@$digest"
    if [[ -n "$RELEASE_PATH" ]]; then
        marker_matches "$target" "$sha" || die "$target does not report release $sha at $RELEASE_PATH"
    fi

    if [[ "$KIND" != worker ]]; then
        # From here the target receives traffic alongside the previous release.
        set_alias "$target" on || die "Could not give $target the alias $BASE"
    fi
    [[ "$KIND" == web ]] && ensure_site

    if [[ -n "$PREVIOUS" && "$PREVIOUS" != "$target" ]]; then
        # Set even when the previous release had already stopped (crashed):
        # recovery must then bring IT back before taking the target away,
        # rather than leave nothing serving.
        PREVIOUS_STOPPED=true
        if [[ "$(c_status "$PREVIOUS")" == "running" ]]; then
            # Graceful: in-flight requests finish; the stop removes it from DNS.
            docker stop --time 15 "$PREVIOUS" >/dev/null || log "WARNING: could not stop $PREVIOUS"
        fi
    fi

    if [[ "$KIND" == web ]]; then
        public_serves "$sha" || die "https://$HOSTNAME_PUBLIC does not serve release $sha$(dns_hint)"
        check_other_domains
    else
        # No public address to check: the target must still be ready now that
        # it carries the load alone.
        wait_ready "$target" || die "$target stopped being ready after the switch"
    fi
    set_live "$target"
}

retire() {   # keep exactly one rollback: remove everything but live + previous
    local keep="$1" name
    while IFS= read -r name; do
        [[ -z "$name" || "$name" == "$TARGET" || "$name" == "$keep" ]] && continue
        log "Removing release older than the retained rollback: $name"
        docker rm -f "$name" >/dev/null || log "WARNING: could not remove $name"
    done < <(app_containers)
}

# OVERLAP=false: two copies must never run at once (a scheduler, a singleton
# worker, an app holding an exclusive file lock). Stop the old one FIRST; for
# a web app this costs a few seconds that Caddy's retries (lb_try_duration)
# largely absorb. Recovery restarts it if the new one fails.
stop_first_if_no_overlap() {
    [[ "$OVERLAP" == false && -n "$PREVIOUS" && "$PREVIOUS" != "$TARGET" ]] || return 0
    PREVIOUS_STOPPED=true
    if [[ "$(c_status "$PREVIOUS")" == "running" ]]; then
        log "OVERLAP=false: stopping $PREVIOUS before starting $TARGET"
        docker stop --time 15 "$PREVIOUS" >/dev/null || die "Could not stop $PREVIOUS"
    fi
}

start_release() {   # create the target container, without the alias
    local sha="$1" digest="$2" path net
    local -a args=(run -d --name "$TARGET" --restart unless-stopped
        --memory "$MEM_LIMIT" --cpus "$CPUS"
        --log-opt max-size=10m --log-opt max-file=5
        --label "algo3.app=$APP" --label "algo3.env=$ENV_NAME"
        --label "algo3.release=$sha" --label "algo3.digest=$digest"
        --label "autoheal=true"
        --network "$NET")
    [[ -f "$ENV_FILE" ]] && args+=(--env-file "$ENV_FILE")
    [[ "$READ_ONLY" == true ]] && args+=(--read-only)
    if [[ -n "$TMPFS" ]]; then
        IFS=',' read -r -a tmpfs_paths <<<"$TMPFS"
        for path in "${tmpfs_paths[@]}"; do args+=(--tmpfs "$path"); done
    fi
    volume_args args
    args+=("$IMAGE@$digest")
    TARGET_WAS_NEW=true
    log "Starting $TARGET"
    docker "${args[@]}" >/dev/null || die "Could not start $TARGET"
    if [[ "$NETWORKS" == *,* ]]; then
        IFS=',' read -r -a extra_networks <<<"${NETWORKS#*,}"
        for net in "${extra_networks[@]}"; do
            docker network connect "$net" "$TARGET" || die "Could not connect $TARGET to $net"
        done
    fi
}

# ── Commands ─────────────────────────────────────────────────────────────────

cmd_deploy() {
    local sha="$1" digest="${2:-}" repo_digests
    require_match sha "$sha" '^[0-9a-f]{40}$'
    [[ -z "$digest" ]] || require_match digest "$digest" '^sha256:[0-9a-f]{64}$'
    ACTION=deploy; TARGET_SHA="$sha"; TARGET_DIGEST="$digest"
    # Here, not in the settings: a typo in it must never block a rollback.
    parse_release_command
    check_domain_ownership
    check_dns

    if [[ -n "$PROMOTE_FROM" ]]; then
        [[ -n "$digest" ]] || die "$ENV_NAME only accepts promoted releases: a digest is required"
        was_live_on "$PROMOTE_FROM" "$sha" "$digest" ||
            die "Release $sha ($digest) was never verified live on $PROMOTE_FROM; refusing to promote"
    fi

    PREVIOUS="$(live_container)"
    TARGET="$BASE-${sha:0:12}"

    if [[ "$PREVIOUS" == "$TARGET" && "$(c_status "$TARGET")" == "running" ]]; then
        if [[ "$KIND" == web ]]; then
            ensure_site
            public_serves "$sha" || die "$TARGET is live but the public check fails$(dns_hint)"
            check_other_domains
        else
            wait_ready "$TARGET" || die "$TARGET is live but not ready"
        fi
        DONE=true
        log "Release $sha is already live on $APP/$ENV_NAME"
        record deploy noop "$sha" "$digest" already-live
        heartbeat ok
        return 0
    fi

    log "Pulling $IMAGE:$sha"
    docker pull "$IMAGE:$sha" >/dev/null || die "Could not pull $IMAGE:$sha"
    repo_digests="$(docker image inspect --format '{{json .RepoDigests}}' "$IMAGE:$sha")"
    if [[ -n "$digest" ]]; then
        [[ "$repo_digests" == *"\"$IMAGE@$digest\""* ]] ||
            die "Tag $IMAGE:$sha does not resolve to $digest (the tag moved, or the wrong digest was sent)"
    else
        digest="$(grep -oE "$IMAGE@sha256:[0-9a-f]{64}" <<<"$repo_digests" | head -1 | cut -d@ -f2 || true)"
        [[ -n "$digest" ]] || die "Could not determine the digest of $IMAGE:$sha"
        TARGET_DIGEST="$digest"
    fi

    if c_exists "$TARGET" && [[ "$(c_label "$TARGET" algo3.digest)" != "$digest" ]]; then
        die "$TARGET exists with a different digest; inspect it before retrying"
    fi

    # Migrations etc. run while the previous release still serves. Failure
    # stops here: nothing has been started or switched.
    run_release_command "$sha" "$digest"

    stop_first_if_no_overlap

    if c_exists "$TARGET"; then
        log "Reusing retained container $TARGET"
        TARGET_WAS_NEW=false
        # A retained release keeps its alias; drop it before starting, so it
        # takes no traffic until it has passed its checks again.
        [[ "$KIND" == worker ]] || set_alias "$TARGET" off
        docker start "$TARGET" >/dev/null || die "Could not start $TARGET"
    else
        start_release "$sha" "$digest"
    fi

    make_live "$TARGET" "$sha" "$digest"
    retire "$PREVIOUS"
    history_add "$sha" "$digest"
    DONE=true
    record deploy ok "$sha" "$digest" "previous=${PREVIOUS:-none}$( ((DOMAIN_WARNINGS)) && echo ",domain-warnings=$DOMAIN_WARNINGS" )"
    heartbeat ok
    log "Deployed $APP/$ENV_NAME $sha"
    log "Rollback retained: ${PREVIOUS:-none}"
}

cmd_rollback() {
    local name sha
    ACTION=rollback
    PREVIOUS="$(live_container)"
    [[ -n "$PREVIOUS" ]] || die "$APP/$ENV_NAME has no live release to roll back from"
    while IFS= read -r name; do
        [[ -n "$name" && "$name" != "$PREVIOUS" ]] && { TARGET="$name"; break; }
    done < <(app_containers)
    [[ -n "$TARGET" ]] || die "No retained release to roll back to"
    sha="$(c_label "$TARGET" algo3.release)"
    require_match "release label of $TARGET" "$sha" '^[0-9a-f]{40}$'
    TARGET_SHA="$sha"; TARGET_DIGEST="$(c_label "$TARGET" algo3.digest)"; TARGET_WAS_NEW=false

    log "Rolling $APP/$ENV_NAME back from $PREVIOUS to $TARGET"
    stop_first_if_no_overlap
    [[ "$KIND" == worker ]] || set_alias "$TARGET" off
    docker start "$TARGET" >/dev/null || die "Could not start $TARGET"
    make_live "$TARGET" "$sha" "$TARGET_DIGEST"
    DONE=true
    record rollback ok "$sha" "$TARGET_DIGEST" "from=$PREVIOUS"
    heartbeat ok
    log "Rolled back. $PREVIOUS is now the retained release; rolling back again returns to it."
}

cmd_status() {
    local name
    printf 'kind: %s\nlive: %s\n' "$KIND" "$(live_container)"
    if [[ "$KIND" == web ]]; then
        local d
        printf 'domain: %s (primary)\n' "$HOSTNAME_PUBLIC"
        for d in ${ALIASES//,/ }; do printf 'domain: %s (alias)\n' "$d"; done
        for d in ${REDIRECTS//,/ }; do printf 'domain: %s (redirects to %s)\n' "$d" "$HOSTNAME_PUBLIC"; done
        printf 'site: %s\n' "$( [[ -f "$TEMPLATE" ]] && echo "from template $TEMPLATE" || echo "generated from the settings" )"
        check_dns
        [[ -z "$SERVER_IPS" ]] && printf 'dns: not checked (set SERVER_IPS in %s)\n' "$ETC/delivery.conf"
        [[ -n "$SERVER_IPS" && ${#DNS_PROBLEMS[@]} -eq 0 ]] && printf 'dns: every domain points at this server\n'
    fi
    while IFS= read -r name; do
        printf '%s  %s  release=%s\n' "$name" "$(c_status "$name")" "$(c_label "$name" algo3.release)"
    done < <(app_containers)
}

main() {
    [[ $# -ge 3 ]] || die "Usage: algo3-deploy deploy|rollback|status <app> <env> [sha] [digest]"
    local command="$1"
    APP="$2"; ENV_NAME="$3"; shift 3
    require_match app "$APP" '^[a-z][a-z0-9-]{1,40}$'
    require_match env "$ENV_NAME" '^[a-z][a-z0-9-]{0,20}$'
    [[ $EUID -eq 0 ]] || die "Must run as root (through algo3-deploy-wrapper or sudo)"
    for cmd in docker curl flock python3 install; do
        command -v "$cmd" >/dev/null || die "Required command unavailable: $cmd"
    done

    load_delivery_conf
    load_app_conf
    mkdir -p "$LOCK_DIR" "$CHECK_DIR" "$SITES_DIR"
    c_exists "$EDGE" || die "Edge container $EDGE is not present"

    case "$command" in
        status) cmd_status; return 0 ;;
        deploy|rollback) ;;
        *) die "Unknown command: $command" ;;
    esac

    exec 9>"$LOCK_DIR/$APP-$ENV_NAME.lock"
    flock -n 9 || die "Another deploy or rollback of $APP/$ENV_NAME is running"
    trap recover EXIT

    if [[ "$command" == deploy ]]; then
        [[ $# -ge 1 && $# -le 2 ]] || die "Usage: algo3-deploy deploy <app> <env> <sha> [digest]"
        cmd_deploy "$@"
    else
        [[ $# -eq 0 ]] || die "Usage: algo3-deploy rollback <app> <env>"
        cmd_rollback
    fi
}

main "$@"
