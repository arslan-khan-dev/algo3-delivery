#!/usr/bin/env python3
"""Fake `docker` for the deployer tests: just enough of the CLI, with state in
$STUB_DIR/state.json and failures injected through STUB_* environment variables.

Containers know their release (label algo3.release). The edge (studio-caddy)
answers wget for a container by name, and `caddy reload` snapshots the routes
in the site files, which the fake curl then serves publicly. So a test can see
whether the route actually changed, not just whether a file was written."""
import hashlib, json, os, sys, time

STATE = os.path.join(os.environ["STUB_DIR"], "state.json")
SITES = os.environ["STUB_SITES_DIR"]
EDGE = "studio-caddy"


def load():
    with open(STATE) as f:
        return json.load(f)


def save(s):
    with open(STATE, "w") as f:
        json.dump(s, f, indent=1)


def digest_for(sha):
    return "sha256:" + hashlib.sha256(sha.encode()).hexdigest()


def flag(name):
    return os.environ.get("STUB_" + name, "")


def fail(msg, code=1):
    print(msg, file=sys.stderr)
    sys.exit(code)


def counter(s, key):
    s.setdefault("counters", {})
    s["counters"][key] = s["counters"].get(key, 0) + 1
    return s["counters"][key]


def release_of(c):
    return c["labels"].get("algo3.release", "")


def ready(s, name):
    c = s["containers"].get(name)
    if not c or c["status"] != "running":
        return False
    rel = release_of(c)
    if rel and rel == flag("NEVER_READY"):
        return False
    if rel and rel == flag("BROKEN_ON_RESTART") and c.get("restarts", 0) > 0:
        return False
    return True


def main(argv):
    s = load()
    cmd = argv[0]

    if cmd == "inspect":
        fmt, name = argv[2], argv[3]
        c = s["containers"].get(name)
        if not c:
            fail(f"Error: No such object: {name}")
        if fmt == "{{.Id}}":
            print(c["id"])
        elif fmt == "{{.State.Status}}":
            print(c["status"])
        elif fmt.startswith("{{if .State.Health}}"):
            rel = release_of(c)
            print("unhealthy" if rel and rel == flag("UNHEALTHY") else "none")
        elif fmt.startswith("{{index .Config.Labels"):
            key = fmt.split('"')[1]
            print(c["labels"].get(key, ""))
        elif fmt == "{{.Created}}":
            print(c["created"])
        else:
            fail(f"stub: unsupported inspect format {fmt}")
        return

    if cmd == "ps":
        filters, i = [], 1
        while i < len(argv):
            if argv[i] == "--filter":
                filters.append(argv[i + 1].split("=", 1)[1]); i += 2
            else:
                i += 1
        for name, c in s["containers"].items():
            if all(c["labels"].get(f.split("=", 1)[0]) == f.split("=", 1)[1] for f in filters):
                print(name)
        return

    if cmd == "pull":
        if flag("PULL_FAIL"):
            fail("Error response from daemon: manifest unknown")
        image = argv[1]
        sha = image.rsplit(":", 1)[1]
        s.setdefault("images", {})[image] = flag("TAG_DIGEST") or digest_for(sha)
        save(s)
        return

    if cmd == "image":
        image = argv[-1]
        d = s.get("images", {}).get(image)
        if not d:
            fail("Error: No such image")
        print(json.dumps([image.rsplit(":", 1)[0] + "@" + d]))
        return

    if cmd == "run":
        name, labels, i = None, {}, 1
        while i < len(argv):
            a = argv[i]
            if a == "--name":
                name = argv[i + 1]; i += 2
            elif a == "--label":
                k, v = argv[i + 1].split("=", 1); labels[k] = v; i += 2
            elif a in ("--restart", "--memory", "--cpus", "--log-opt", "--network", "--env-file", "--tmpfs"):
                i += 2
            else:
                i += 1
        if name in s["containers"]:
            fail(f"Conflict. The container name {name} is already in use")
        if flag("RUN_FAIL"):
            fail("Error: run failed")
        status = "exited" if labels.get("algo3.release") == flag("EXIT_ON_START") else "running"
        s["containers"][name] = {"id": hashlib.sha1(name.encode()).hexdigest(), "status": status,
                                 "labels": labels, "created": "%.6f" % time.time(), "restarts": 0,
                                 "image": argv[-1]}
        save(s)
        print(s["containers"][name]["id"])
        return

    if cmd in ("start", "stop"):
        name = argv[1]
        c = s["containers"].get(name)
        if not c:
            fail(f"Error: No such container: {name}")
        if cmd == "start":
            if c["status"] != "running":
                c["restarts"] = c.get("restarts", 0) + 1
            c["status"] = "running"
        else:
            c["status"] = "exited"
        save(s)
        print(name)
        return

    if cmd == "rm":
        name = argv[-1]
        if name not in s["containers"]:
            fail(f"Error: No such container: {name}")
        del s["containers"][name]
        save(s)
        return

    if cmd == "logs":
        print("stub log line")
        return

    if cmd == "network":
        return

    if cmd == "exec":
        target, rest = argv[1], argv[2:]
        if target != EDGE or s["containers"].get(EDGE, {}).get("status") != "running":
            fail("Error: container not running")
        if rest[0] == "cat":
            print(f"{{\n\tadmin localhost:2019\n}}\nimport {SITES}/*.caddy")
            return
        if rest[0] == "wget":
            url = rest[-1]
            host, path = url[len("http://"):].split("/", 1)
            name = host.split(":")[0]
            if not ready(s, name):
                fail("wget: can't connect to remote host")
            if path.endswith("release.json"):
                rel = release_of(s["containers"][name])
                if rel == flag("WRONG_MARKER"):
                    rel = "0" * 40
                print(json.dumps({"release": rel}))
            else:
                print("<html>ok</html>")
            return
        if rest[0] == "caddy" and rest[1] == "validate":
            if flag("VALIDATE_FAIL"):
                fail("Error: adapting config using caddyfile: invalid")
            return
        if rest[0] == "caddy" and rest[1] == "reload":
            n = counter(s, "reload")
            fails = int(flag("RELOAD_FAIL") or 0)
            if n <= fails:
                save(s)
                fail("Error: reload failed")
            routes = {}
            for f in sorted(os.listdir(SITES)):
                if not f.endswith(".caddy"):
                    continue
                with open(os.path.join(SITES, f)) as fh:
                    lines = fh.read().splitlines()
                upstream = next((p.split("=", 1)[1] for p in lines[0].split() if p.startswith("upstream=")), "")
                for line in lines:
                    if line.rstrip().endswith("{") and not line.startswith(("\t", " ")):
                        routes[line.split()[0]] = upstream
            s["routes"] = routes
            save(s)
            return
        fail(f"stub: unsupported exec {rest}")

    fail(f"stub: unsupported docker command {argv}")


main(sys.argv[1:])
