#!/usr/bin/env python3
"""Fake `curl`. With --resolve it plays the public edge: it serves whatever the
LAST SUCCESSFUL `caddy reload` routed the hostname to. Without --resolve it is
a heartbeat ping, recorded in $STUB_DIR/heartbeats."""
import json, os, sys

STATE = os.path.join(os.environ["STUB_DIR"], "state.json")
args = sys.argv[1:]
url = args[-1]

if "--resolve" not in args:
    with open(os.path.join(os.environ["STUB_DIR"], "heartbeats"), "a") as f:
        f.write(url + "\n")
    sys.exit(0)

with open(STATE) as f:
    s = json.load(f)
hostport, _, path = url[len("https://"):].partition("/")
host = hostport.split(":")[0]
with open(os.path.join(os.environ["STUB_DIR"], "public-urls"), "a") as f:
    f.write(url + "\n")
# The edge routes a host to an alias (from the last successful reload); Docker
# DNS answers that alias with whichever RUNNING containers hold it.
alias = s.get("routes", {}).get(host)
serving = [c for c in s["containers"].values() if c["status"] == "running" and alias and alias in c.get("aliases", [])]
c = max(serving, key=lambda x: x["created"]) if serving else None
if os.environ.get("STUB_PUBLIC_FAIL") or not c:
    sys.exit(22)
rel = c["labels"].get("algo3.release", "")
if rel and rel == os.environ.get("STUB_NEVER_READY", ""):
    sys.exit(22)
if path.endswith("release.json"):
    if os.environ.get("STUB_PUBLIC_WRONG"):
        rel = "f" * 40
    print(json.dumps({"release": rel}))
else:
    print("<html>ok</html>")
