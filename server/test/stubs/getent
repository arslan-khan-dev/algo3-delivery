#!/usr/bin/env python3
"""Fake `getent ahosts <name>`. STUB_DNS="a.example=1.2.3.4 b.example=5.6.7.8,::1"
gives each name its addresses; any other name does not resolve (exit 2)."""
import os, sys

if sys.argv[1:2] != ["ahosts"]:
    sys.exit(f"stub getent: unsupported {sys.argv[1:]}")
table = dict(pair.split("=", 1) for pair in os.environ.get("STUB_DNS", "").split() if "=" in pair)
ips = table.get(sys.argv[2])
if not ips:
    sys.exit(2)
for ip in ips.split(","):
    print(f"{ip}      STREAM {sys.argv[2]}")
