# /opt/algo3/edge/.env — root-only (0600). Created once by install.sh.
# Let's Encrypt account e-mail: expiry warnings go here.
ACME_EMAIL=
# Dry-run ports, used ONLY while proving the edge beside the old host Caddy.
# The cutover removes these two lines (the edge then takes 80/443).
EDGE_HTTP_PORT=18080
EDGE_HTTPS_PORT=18443
# Lab only. Leave empty on the server.
EDGE_LAB_OPTIONS=
